# Copy this file to .env and fill in your keys.

# SerpApi — required by the hackathon
SERPAPI_API_KEY=your_serpapi_key_here

# Configure one or more LLM providers; the router tries them in task-specific order.
OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_API_KEY=your_groq_key_here
NVIDIA_API_KEY=your_nvidia_key_here
GEMINI_API_KEY=your_gemini_key_here

# Optional legacy OpenAI fallback.
OPENAI_API_KEY=your_openai_key_here

# Used only when an OpenAI key is configured.
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini

# Optional: app settings
# Automatic self-heal attempts (0 or 1)
MAX_RETRIES=1
MAX_VERIFIER_RETRIES=3
SANDBOX_TIMEOUT=30
