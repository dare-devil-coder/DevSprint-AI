# Copy this file to .env and fill in your keys.

# SerpApi — required by the hackathon
SERPAPI_API_KEY=your_serpapi_key_here

# OpenAI — used by all agents for code generation and reasoning
OPENAI_API_KEY=your_openai_key_here

# Optional: model name
OPENAI_MODEL=gpt-4o

# Optional: app settings
MAX_RETRIES=5
SANDBOX_TIMEOUT=30